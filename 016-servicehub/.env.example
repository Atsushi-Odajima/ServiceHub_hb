# ---- ServiceHub 環境変数(例) ----
# 本番では必ず値を変更し、秘密情報はホスティングの環境変数/Secret機能で設定してください(リポジトリに保存しない)。
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
# 接続ロールは superuser / BYPASSRLS を持たないこと(テナント分離のRLSが無効になるため)
DATABASE_URL=postgres://servicehub:servicehub_dev_pw@127.0.0.1:5432/servicehub_dev
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
# 32文字以上のランダム文字列(例: openssl rand -base64 48)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=auto
TRUST_PROXY=false
MIGRATE_ON_START=true
# web プロセス内で通知ワーカー/スケジューラも動かす(小規模向け)。分ける場合は false にして start:worker を別プロセスで起動
RUN_WORKER=true
# log: 実際には送信せずDBと標準出力に記録(既定) / smtp: SMTP_URL で送信
EMAIL_PROVIDER=log
EMAIL_FROM="ServiceHub <no-reply@example.invalid>"
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# 検証環境で送信先を制限する場合(カンマ区切りのドメインまたはアドレス)
# EMAIL_ALLOWLIST=example.com,owner@example.org
# 公開予約のbot対策(任意): Cloudflare Turnstile
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# バックアップファイル暗号化用パスフレーズ(任意・16文字以上)。設定するとバックアップは暗号化され、復元には同じ値が必要(紛失すると復元できない)
# BACKUP_ENCRYPTION_KEY=
# 画面から復元できるバックアップファイルの上限(MB)。これより大きい場合はコマンドで復元
# BACKUP_UPLOAD_MAX_MB=200
LOG_LEVEL=info

# docker compose 用の設定例。docker-compose.yml と同じフォルダの .env にコピーして値を変更する。
# 秘密情報(パスワード・SESSION_SECRET・SMTP_URL・BACKUP_ENCRYPTION_KEY)は他人に見せない・リポジトリに入れない。

# PostgreSQL の管理者パスワード(DB の初期化にだけ使う)とアプリ用ロールのパスワード。長いランダム文字列に変更
# (接続URLに埋め込むため英数字だけにする。例: openssl rand -hex 24)。DB の初回起動後に変えても反映されない
POSTGRES_PASSWORD=change-me-postgres-admin-password
APP_DB_PASSWORD=change-me-app-db-password

# 公開するURL(メールのリンクと送信元チェックに使う)。HTTPS で公開する場合は https://
APP_BASE_URL=http://localhost:3000
APP_PORT=3000
# 32文字以上のランダム文字列(例: openssl rand -base64 48)。引っ越し時は同じ値を使う(予約管理リンクの生成に使うため)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# リバースプロキシの後ろで動かす場合は true
TRUST_PROXY=false

# 初回だけ: 最初の組織とオーナー(組織が1つもないときだけ作成。ログインできたら SETUP_OWNER_PASSWORD を消す)
SETUP_ORG_SLUG=my-salon
SETUP_ORG_NAME=マイサロン
SETUP_OWNER_EMAIL=owner@example.com
SETUP_OWNER_PASSWORD=
SETUP_OWNER_NAME=オーナー
SETUP_LOCATION_NAME=本店
# 試用のためにサンプル組織(Sample Wellness)も作る場合は true(メールは送信されない)。
# サンプルのログイン情報は説明書で公開されているため、実際の顧客が使う環境では false のままにする
SEED_SAMPLE_ON_START=false

# メール: log = 送信せず記録のみ(既定) / smtp = SMTP_URL で送信
EMAIL_PROVIDER=log
EMAIL_FROM=ServiceHub <no-reply@example.invalid>
SMTP_URL=
# バックアップの暗号化(任意・16文字以上)。紛失すると復元できないので別に保管する
BACKUP_ENCRYPTION_KEY=
LOG_LEVEL=info
